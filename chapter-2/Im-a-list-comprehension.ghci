-- double all elements of [1..10]
[2*x | x <- [1..10]]


-- with predicate
[2*x | x <- [1..10], 2*x >= 12]

-- more complex, all numbers in 50..100 which are 3 mod 7
[x | x <- [50..100], mod x 7 == 3]

-- replace odd greater than 10 with "BANG!", replace odd less than 10 with "BOOM!",ignore the rest
bangBoomPredicate xs = [if x < 10 then "BOOM!" else "BANG!" | x <- xs, odd x]
bangBoomPredicate [7..13]

-- MULTIPLE PREDICATES
-- numbers in 10..20 that are not 13, 15, or 19
[x | x <- [10..20], x/=13, x/=15, x/=19]

-- DRWAING ELEMENTS FROM MULTIPLE LISTS
[x * y | x <- [2, 5, 10], y <- [8, 10, 11]]


-- REWRITING LENGTH FUNCTION
length' xs = sum [1 | _ <- xs]

removeNonUppercase st = [c | c <- st, c `elem` ['A'..'Z']]
removeNonUppercase "Hahaha! Ahahaha!"

removeNonUppercase "IdontLIKEFROGS"

-- NESTED LISTS
nestedList = [[1,3,5,2,3,1,2,4,5],[1,2,3,4,5,6,7,8,9],[1,2,4,2,1,6,3,1,3,2,3,6]]
[[x | x <- xs, even x] | xs <- nestedList]
