:load pattern-matching.hs
head' [4, 5, 6]
head' "Hello"

charName 'a'
-- charName 'h' -- triggers non-exhaustive pattern matching error by ghci

let xs = [(1,3), (4,3), (2,4), (5,3), (5,6), (3,1)]
[a+b | (a, b) <- xs]

capital "Dracula"

:load guards-guards.hs

densityTell 24.3

densityTell' 400 1

max' 2 3

2 `myCompare` 3
