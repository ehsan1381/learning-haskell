-- PATTERN MATCHING
lucky :: (Integral a) => a -> String
lucky 7 = "LUCKY NUMBER 7!"
lucky x = "Sorry, you are out of luch, pal!"


-- sayMe function
sayMe :: (Integral a) => a -> String
sayMe 1 = "One"
sayMe 2 = "Two"
sayMe 3 = "Three"
sayMe 4 = "Four"
sayMe 5 = "Five"
sayMe x = "Not between 1 and 5"

-- sayMe' function
sayMe' :: (Integral a) => a -> String
sayMe x = "Not between 1 and 5"
sayMe 1 = "One"
sayMe 2 = "Two"
sayMe 3 = "Three"
sayMe 4 = "Four"
sayMe 5 = "Five"

-- factorial function
factorial :: (Integral a) => a -> a
factorial 0 = 1
factorial x = factorial (x - 1)

-- factorial' function -- this will never terminate
-- factorial :: (Integral a) => a -> a
-- factorial x = factorial (x - 1)
-- factorial 0 = 1

-- function charName -- not exhaustive
charName :: Char -> String
charName 'a' = "Albert"
charName 'b' = "Broseph"
charName 'c' = "Cecil"
charName 'a'
-- charName 'h' -- will return an exception

-- addVectors function -- not using pattern matching
addVectors :: (Num a) => (a, a) -> (a, a) -> (a, a)
addVectors a b = (fst a + fst b, snd a + snd b)

-- addVectors function -- using pattern matching
addVectors' :: (Num a) => (a, a) -> (a, a) -> (a, a)
addVectors' (x1, y1) (x2, y2) = (x1 + x2, y1 + y2)


-- pattern matching on lists
let xs = [(1,3), (4,3), (2,4), (5,3), (5,6), (3,1)]
[a+b | (a,b) <- xs]

